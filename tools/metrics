#!/usr/bin/env python3
"""Measure fleet's code-health numbers and print them as one row of brain/metrics.md.

Run: python3 tools/metrics          (minutes: a clean build, both test lanes, clippy)
     python3 tools/metrics --dry    (seconds: counts only, the slow columns read "skipped")

The release health pass runs it and appends the row it prints to the table in
brain/metrics.md (CONTRIBUTING.md § Code health). The row's columns match that
table's header, in order. The numbers are read as a trend, so the same command
must measure the same thing every time: change what a column measures and the
table's earlier rows stop being comparable, which brain/metrics.md must then say.
"""
import json
import re
import subprocess
import sys
import time
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CRATES = ("core", "controller", "cli")


def run(args):
    """Run a command at the workspace root; return (seconds, exit code, output)."""
    start = time.monotonic()
    out = subprocess.run(args, cwd=ROOT, capture_output=True, text=True)
    return time.monotonic() - start, out.returncode, out.stdout + out.stderr


def suite(profile):
    """One nextest lane: '<tests> · <seconds>s', with its failures if any."""
    args = ["cargo", "nextest", "run", "--workspace", "--no-fail-fast", "--color", "never"]
    if profile:
        args += ["--profile", profile]
    secs, _, out = run(args)
    summary = re.search(r"^\s*Summary .*?(\d+) tests? run: (\d+) passed(.*)$", out, re.MULTILINE)
    if not summary:
        return f"no summary · {secs:.1f}s"
    cell = f"{summary.group(1)} · {secs:.1f}s"
    # Whatever else the summary counts (failed, timed out) is named, never dropped.
    for count, kind in re.findall(r"(\d+) (failed|timed out)", summary.group(3)):
        if count != "0":
            cell += f" · {count} {kind}"
    return cell


def tests_by_crate():
    """Tests in the default lane, per crate, as nextest lists them."""
    # stdout alone: cargo's build chatter goes to stderr and is not JSON.
    out = subprocess.run(
        ["cargo", "nextest", "list", "--workspace", "--message-format", "json"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if out.returncode != 0:
        return "list failed"
    suites = json.loads(out.stdout)["rust-suites"]
    counts = dict.fromkeys(CRATES, 0)
    for binary, suite_ in suites.items():
        crate = binary.split("::")[0].removeprefix("fleet-")
        if crate in counts:
            counts[crate] += sum(
                1
                for case in suite_["testcases"].values()
                if case["filter-match"]["status"] == "matches"
            )
    return " / ".join(str(counts[c]) for c in CRATES)


def source_files(crate):
    return sorted((ROOT / crate / "src").rglob("*.rs"))


def lines(path):
    with open(path, encoding="utf-8") as f:
        return sum(1 for _ in f)


def lines_by_crate():
    return " / ".join(str(sum(lines(p) for p in source_files(c))) for c in CRATES)


def largest_source_file():
    path = max((p for c in CRATES for p in source_files(c)), key=lines)
    return f"{path.relative_to(ROOT)} ({lines(path)})"


def clippy_allows():
    return sum(
        p.read_text(encoding="utf-8").count("allow(clippy")
        for c in CRATES
        for p in (ROOT / c).rglob("*.rs")
        if "target" not in p.parts
    )


def clippy_warnings():
    _, code, out = run(
        ["cargo", "clippy", "--workspace", "--all-targets", "--message-format", "short", "--color", "never"]
    )
    if code != 0:
        return "failed"
    return len(re.findall(r"^\S+:\d+:\d+: warning", out, re.MULTILINE))


def clauses_without_scenario():
    """Clause ids in feature specs that no scenario covers. Scenarios live in
    fleet-dtu, which this repository cannot see, so until fleet-dtu reports its
    coverage the column reads how many clauses exist at all."""
    specs = [
        p
        for p in (ROOT / "brain" / "specs").rglob("*.md")
        if p.name not in ("mod.md", "seed.md")
    ]
    ids = set()
    for p in specs:
        ids.update(re.findall(r"\b[a-z-]+\.[a-z-]+\.[RN]\d+\b", p.read_text(encoding="utf-8")))
    return f"n/a ({len(ids)} clauses)"


def main():
    dry = "--dry" in sys.argv[1:]
    _, code, sha = run(["git", "rev-parse", "--short", "HEAD"])
    sha = sha.strip() if code == 0 else "unknown"
    _, _, changes = run(["git", "status", "--porcelain"])
    if changes.strip():
        sha += "-dirty"  # measured on uncommitted changes: the row is not reproducible
    if dry:
        build = default_lane = ring_lane = warnings = "skipped"
    else:
        _, code, _ = run(["cargo", "clean"])
        secs, built, _ = run(["cargo", "build", "--workspace", "--all-targets"])
        if code != 0:
            build = "clean failed"
        else:
            build = f"{secs:.1f}s" if built == 0 else "failed"
        default_lane = suite(None)
        ring_lane = suite("ring")
        warnings = clippy_warnings()
    cells = [
        date.today().isoformat(),
        sha,
        build,
        default_lane,
        ring_lane,
        tests_by_crate(),
        lines_by_crate(),
        largest_source_file(),
        f"{clippy_allows()} / {warnings}",
        clauses_without_scenario(),
    ]
    print("| " + " | ".join(str(c) for c in cells) + " |")


if __name__ == "__main__":
    main()
