#!/bin/sh
# A sandbox for trying fleet by hand (fleet-nbmo).
#
#   tools/try                 a shell in the sandbox; exit it to clean up
#   tools/try -c 'commands'   run the commands in the sandbox instead
#
# It builds fleet into target/try (never target/debug, which a real
# supervisor may run from) with the debug feature, for `fleet debug`, makes
# a temp directory with three git repos and a state directory, runs a
# supervisor on that state by hand, and opens
# a shell where `fleet` is that build and FLEET_STATE_DIR points at the
# sandbox. Leaving it stops that supervisor, by its pid, and deletes the
# directory. Nothing in it reaches the real state directory.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
bin_dir=$root/target/try/debug

fail() {
    printf 'try: %s\n' "$1" >&2
    exit 1
}

say() {
    printf '%s\n' "$1" >&2
}

repo() {
    mkdir -p "$1"
    git -C "$1" init -q
    printf '# %s\n' "$(basename "$1")" >"$1/README.md"
    git -C "$1" add README.md
    git -C "$1" -c user.name=try -c user.email=try@localhost commit -qm "first commit"
}

# Whether a launchd or systemd unit was installed for the sandbox's state:
# a sandbox `fleet start` does that when no real unit is installed.
unit_serves_sandbox() {
    for unit in "$HOME/Library/LaunchAgents/com.tinyish.fleet.supervisor.plist" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-supervisor.service"; do
        grep -qsF "$state" "$unit" && return 0
    done
    return 1
}

cleanup() {
    trap - EXIT INT TERM
    if unit_serves_sandbox; then
        FLEET_STATE_DIR=$state "$bin_dir/fleet" stop >/dev/null 2>&1 || true
    fi
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    rm -rf "$sb"
    say "try: the sandbox is gone"
}

# Writes the rc files that load the person's own, then point the shell at
# the sandbox: after them, so their PATH cannot put another fleet first.
shell_rc() {
    rc=$sb/.rc
    mkdir -p "$rc"
    cat >"$rc/sandbox.sh" <<EOF
export FLEET_STATE_DIR='$state'
export PATH='$bin_dir':"\$PATH"
alias state="sqlite3 '$state/state.sqlite3'"
cd '$sb'
EOF
    cat >"$rc/.zshenv" <<'EOF'
[ -f "$HOME/.zshenv" ] && . "$HOME/.zshenv"
EOF
    cat >"$rc/.zshrc" <<EOF
ZDOTDIR=\$HOME
[ -f "\$HOME/.zshrc" ] && . "\$HOME/.zshrc"
. '$rc/sandbox.sh'
PROMPT="(fleet sandbox) \$PROMPT"
EOF
    cat >"$rc/.bashrc" <<EOF
[ -f "\$HOME/.bashrc" ] && . "\$HOME/.bashrc"
. '$rc/sandbox.sh'
PS1="(fleet sandbox) \$PS1"
EOF
}

banner() {
    say "fleet sandbox: $sb"
    say "  repos: code/app, code/api, code/blog; state: state/ (\`state\` opens it in sqlite3)"
    say "  the supervisor runs by hand (pid $pid); its log is state/supervisor.log"
    say "  plain \`fleet stop\`, and \`fleet start\` while this supervisor is down, are refused"
    say "  while your real supervisor is installed. Do not follow that refusal's hint here:"
    say "  it stops your real supervisor."
    say "  \`fleet debug launch|list|stop\` drives agents' sessions; watch one with"
    say "  \`tmux -S state/tmux.sock attach -t <id>\`"
    say "  exit the shell to stop this supervisor and delete the sandbox"
}

main() {
    if [ "${1:-}" = -c ]; then
        [ $# -eq 2 ] || fail "usage: tools/try [-c 'commands']"
    elif [ $# -ne 0 ]; then
        fail "usage: tools/try [-c 'commands']"
    fi
    [ -z "${FLEET_STATE_DIR:-}" ] || fail "FLEET_STATE_DIR is already set; is this a sandbox already?"

    CARGO_TARGET_DIR=$root/target/try cargo build -q -p fleet --features debug \
        --manifest-path "$root/Cargo.toml" ||
        fail "the build failed"

    tmp=${TMPDIR:-/tmp}
    sb=$(mktemp -d "${tmp%/}/fleet-try.XXXXXX")
    sb=$(cd "$sb" && pwd -P)
    state=$sb/state
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    for name in app api blog; do
        repo "$sb/code/$name"
    done
    mkdir -p "$state"
    FLEET_STATE_DIR=$state "$bin_dir/fleet" supervise 2>>"$state/supervisor.log" &
    pid=$!
    tries=0
    until [ -S "$state/supervisor.sock" ]; do
        kill -0 "$pid" 2>/dev/null || fail "the supervisor stopped: $(cat "$state/supervisor.log")"
        tries=$((tries + 1))
        [ "$tries" -le 100 ] || fail "the supervisor did not start within 10s"
        sleep 0.1
    done

    if [ "${1:-}" = -c ]; then
        (
            cd "$sb"
            FLEET_STATE_DIR=$state PATH=$bin_dir:$PATH sh -c "$2"
        )
        return
    fi

    shell_rc
    banner
    # A Ctrl-C at the prompt belongs to the shell, not to this script.
    trap ':' INT
    cd "$sb"
    status=0
    case "${SHELL:-}" in
        */zsh) ZDOTDIR=$sb/.rc FLEET_STATE_DIR=$state zsh -i || status=$? ;;
        */bash) FLEET_STATE_DIR=$state bash --rcfile "$sb/.rc/.bashrc" -i || status=$? ;;
        *) FLEET_STATE_DIR=$state PATH=$bin_dir:$PATH PS1='(fleet sandbox) $ ' sh -i || status=$? ;;
    esac
    return "$status"
}

main "$@"
